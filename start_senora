#!/usr/bin/env bash
# Start Senora with one command:
#   ./start_senora                              the page on this computer (opens http://localhost:8001)
#   ./start_senora --port 8002                  another port
#   ./start_senora --no-browser                 do not open the browser
#   ./start_senora --dev                        restart by itself when the code changes (development only: a restart stops a build)
#   ./start_senora install-helper               once: lets the Connect button on a hosted page start the helper on this computer
#   ./start_senora helper https://your-page     the same from the terminal (asks for the code once)
set -e
cd "$(dirname "$0")"

if [ "$1" = "send" ]; then
  # render a playlist on GitHub:  ./start_senora send <playlist project.json>
  shift; exec "$(dirname "$0")/.venv/bin/python" -m helper.send "$@"
fi

if [ "$1" = "install-helper" ]; then
  # one-time: makes "Senora Helper.app" so the Start button on the Senora page can start Senora on this Mac.
  # macOS blocks apps from running code inside Desktop/Documents, so a copy of Senora is kept in a folder it can use.
  APPDIR="${SENORA_APP_DIR:-$HOME/Applications}"; APP="$APPDIR/Senora Helper.app"; REPO="$(pwd)"
  HOMEDIR="$HOME/Library/Application Support/Senora"
  mkdir -p "$APPDIR" "$HOMEDIR"
  rsync -a --exclude .venv --exclude work --exclude .git --exclude __pycache__ --exclude jobs "$REPO/" "$HOMEDIR/"
  if [ -d "$REPO/work/ui" ]; then mkdir -p "$HOMEDIR/data" && rsync -a "$REPO/work/ui/" "$HOMEDIR/data/"; fi
  git -C "$REPO" remote get-url origin > "$HOMEDIR/.senora_remote" 2>/dev/null || true      # where the helper sends the songs
  rm -rf "$APP"
  TMP="$(mktemp -d)"
  cat > "$TMP/helper.applescript" <<'OSA'
on open location theURL
	do shell script "export PATH=/opt/homebrew/bin:/usr/local/bin:$PATH; export SENORA_DATA=$HOME/Library/Application\\ Support/Senora/data; mkdir -p $HOME/.senora_helper; cd $HOME/Library/Application\\ Support/Senora && (nohup ./start_senora --no-browser >> $HOME/.senora_helper/senora.log 2>&1 &)"
end open location
on run
	display dialog "Senora is starting on this Mac. Go back to your Senora page; it will connect by itself." buttons {"OK"} with title "Senora"
end run
OSA
  osacompile -o "$APP" "$TMP/helper.applescript"
  plutil -insert CFBundleURLTypes -json '[{"CFBundleURLName":"Senora Helper","CFBundleURLSchemes":["senora-helper"]}]' "$APP/Contents/Info.plist"
  plutil -replace LSUIElement -bool true "$APP/Contents/Info.plist" 2>/dev/null || true
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$APP" 2>/dev/null || true
  echo "Installed: $APP"
  echo "Senora's copy for the helper: $HOMEDIR (your playlists were copied there too; the ones on Desktop are untouched)"
  echo "Now press 'Connect my computer' on your Senora page. The first time, your browser asks to open Senora Helper: allow it."
  echo "If macOS says it cannot verify the app: right-click it in Finder, Open, Open (only once)."
  exit 0
fi

HELPER=0
if [ "$1" = "helper" ]; then HELPER=1; shift; fi
PORT=8001; OPEN=1; DEV=0
while [ $# -gt 0 ]; do
  case "$1" in
    --port) PORT="$2"; shift 2 ;;
    --no-browser) OPEN=0; shift ;;
    --dev) DEV=1; shift ;;
    -h|--help) sed -n '2,8p' "$0"; exit 0 ;;
    *) if [ "$HELPER" = "1" ]; then break; fi; echo "Unknown option: $1 (try ./start_senora --help)"; exit 2 ;;
  esac
done

# 1. a Python with our packages: this folder's .venv, else the one used so far, else a new .venv
PY=""
for CAND in "./.venv/bin/python" "$HOME/Desktop/senora/senora/.venv/bin/python"; do
  if [ -x "$CAND" ] && "$CAND" -c "pass" >/dev/null 2>&1; then PY="$CAND"; break; fi      # one macOS blocks (Desktop) is skipped
done
if [ -z "$PY" ]; then
  echo "First run: making a Python environment in .venv ..."
  python3 -m venv .venv
  PY="./.venv/bin/python"
fi

# 2. ffmpeg is needed for everything audio and video
if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "ffmpeg is not installed. Install it once with:  brew install ffmpeg"
  exit 1
fi

# 3. packages (only installs when something is missing)
if ! "$PY" -c "import fastapi, uvicorn, PIL, numpy, yt_dlp, mutagen, requests, multipart" >/dev/null 2>&1; then
  echo "Installing the packages (first run only, about a minute) ..."
  "$PY" -m pip install -q -r requirements.txt
fi

if [ "$HELPER" = "1" ]; then exec "$PY" -m helper "$@"; fi

# 4. an older Senora page on the same port is stopped first (only Senora's own, never another program)
pkill -f "uvicorn server.app:app --port $PORT" >/dev/null 2>&1 && sleep 1 || true
if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "Port $PORT is used by another program. Try:  ./start_senora --port 8002"
  exit 1
fi

echo "Senora is starting at  http://localhost:$PORT   (press Ctrl+C to stop; everything you did is saved as you go)"
if [ "$OPEN" = "1" ]; then
  ( sleep 2; open "http://localhost:$PORT" >/dev/null 2>&1 || true ) &
fi
if [ "$DEV" = "1" ]; then
  exec "$PY" -m uvicorn server.app:app --port "$PORT" --reload --reload-dir server --reload-dir engine
fi
exec "$PY" -m uvicorn server.app:app --port "$PORT"
